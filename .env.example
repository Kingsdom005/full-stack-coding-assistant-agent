# 全栈代码助手智能体 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 腾讯混元 API 配置 ====================
# 获取 API Key: https://cloud.tencent.com/product/hunyuan
TENCENT_API_KEY=your_tencent_api_key_here
TENCENT_API_BASE=https://api.hunyuan.cloud.tencent.com/hyllm/v1

# ==================== LiteLLM 配置 ====================
# LiteLLM 主密钥（用于 Fallback 和成本追踪）
LITELLM_MASTER_KEY=your_litellm_master_key_optional

# ==================== 数据库配置 ====================
# SQLite 数据库路径
SQLITE_DB_PATH=./context.db

# ==================== CodeBuddy CLI 配置 ====================
# CodeBuddy CLI 路径（如果在 PATH 中可留空）
CODEBUDDY_CLI_PATH=codebuddy

# 代码执行超时时间（秒）
CODEBUDDY_TIMEOUT=60

# ==================== 应用配置 ====================
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 调试模式
DEBUG=false
